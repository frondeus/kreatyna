<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug only. The unit-test host is the sandboxed app, so snapshot tests
	     need this folder to read and record their baseline images. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>$(SRCROOT)/KreatynaMacTests/Snapshots/</string>
	</array>
</dict>
</plist>
