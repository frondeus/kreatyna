{
	"name": "kreatyna",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"docker:up": "docker-compose up -d",
		"dev": "npm run docker:up && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:fmt && npm run lint:ts",
		"lint:fmt": "prettier --plugin-search-dir . --check .",
		"lint:ts": "eslint .",
		"lint:watch": "npm run lint && onchange **/* -- npm run lint",
		"lint:watch-fmt": "npm run lint:fmt && onchange **/* -- npm run lint:fmt",
		"lint:watch-ts": "npm run lint:ts && onchange **/* -- npm run lint:ts",
		"format": "prettier --plugin-search-dir . --write .",
		"format:watch": "npm run format && onchange **/* -- npm run format",
		"prisma:studio": "npm run docker:up && prisma studio &",
		"prisma:seed": "prisma db seed",
		"prisma:reset": "prisma migrate reset",
		"prisma:dump": "tsx prisma/dump.ts",
		"test": "npm run test:integration && npm run test:unit",
		"test:integration": "npm run docker:up && playwright test",
		"test:unit": "vitest"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.1.52",
		"@playwright/test": "^1.28.1",
		"@skeletonlabs/skeleton": "^1.8.0",
		"@sveltejs/adapter-auto": "^2.0.0",
		"@sveltejs/kit": "^1.20.4",
		"@tailwindcss/forms": "^0.5.3",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.45.0",
		"autoprefixer": "^10.4.14",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"onchange": "^7.1.0",
		"postcss": "^8.4.24",
		"postcss-load-config": "^4.0.1",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"prisma": "^5.0.0",
		"svelte": "^4.0.0",
		"svelte-check": "^3.4.3",
		"svelte-language-server": "^0.15.13",
		"sveltekit-superforms": "^1.1.3",
		"tailwindcss": "^3.3.2",
		"tslib": "^2.4.1",
		"tsx": "^3.12.7",
		"typescript": "^5.0.0",
		"unplugin-icons": "^0.16.3",
		"vite": "^4.3.6",
		"vitest": "^0.32.2",
		"zod": "^3.21.4"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.4.4",
		"@lucia-auth/adapter-prisma": "^3.0.0",
		"@prisma/client": "^5.0.0",
		"lucia": "^2.0.0",
		"openai": "^3.3.0",
		"typechat": "^0.0.10",
		"uuid": "^9.0.0",
		"xlsx-import": "^2.4.4"
	}
}
