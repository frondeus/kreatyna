generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @unique
  username     String    @unique
  full_name    String?
  auth_session Session[]
  auth_key     Key[]
  is_admin   Boolean   @default(false)
  raw Raw[]
}

model Session {
  id             String @id @unique
  user_id        String
  active_expires BigInt
  idle_expires   BigInt
  // Relations
  user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Key {
  id              String  @id @unique
  hashed_password String?
  user_id         String
  // Relations
  user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Raw {
  id                  Int                  @id @default(autoincrement())
  created_by          String?
  name                String
  container           Int
  proteins            Decimal              @db.Decimal
  carbs               Decimal              @db.Decimal
  fat                 Decimal              @db.Decimal
  tagId               Int?
  // Relations
  creator                User?             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipiesIngredients RecipiesIngredient[]
  tags                Tag[]
}

model Recipie {
  id                  BigInt               @id @unique @default(autoincrement())
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  name                String               @default("")
  portions            BigInt               @default(1)
  steps               Json                 @default("[]") @db.Json
  // Relations
  recipiesIngredients RecipiesIngredient[]
  tags                 Tag[]
}

model RecipiesIngredient {
  id        BigInt  @id @unique @default(autoincrement())
  recipe_id BigInt
  raw_id    Int?
  name      String  @default("")
  amount    Decimal @default(0) @db.Decimal
  unit      String?
  // Relations
  raw       Raw?    @relation(fields: [raw_id], references: [id], onUpdate: NoAction)
  recipies  Recipie @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model TagCategory {
  id        Int     @id @unique @default(autoincrement())
  name      String  @default("") @unique
  // Relations
  tags      Tag[]
}

model Tag {
  id        Int     @id @unique @default(autoincrement())
  name      String  @default("")
  categoryId Int
  // Relations
  category  TagCategory @relation(fields: [categoryId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  raws      Raw[]
  recipies  Recipie[]

  @@unique([name, categoryId])
}

