generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id           String    @id @unique
  username     String    @unique
  full_name    String?
  auth_session Session[]
  auth_key     Key[]
  is_admin     Boolean   @default(false)
  raw          Raw[]
}

model Session {
  id             String @id @unique
  user_id        String
  active_expires BigInt
  idle_expires   BigInt
  // Relations
  user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Key {
  id              String  @id @unique
  hashed_password String?
  user_id         String
  // Relations
  user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Raw {
  id                 Int                 @id @default(autoincrement())
  created_by         String?
  name               String
  container          Int
  proteins           Decimal             @db.Decimal
  carbs              Decimal             @db.Decimal
  fat                Decimal             @db.Decimal
  tagId              Int?
  // Relations
  creator            User?               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipesIngredients RecipesIngredient[]
  tags               Tag[]
}

model Recipe {
  id                 BigInt              @id @unique @default(autoincrement())
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  name               String              @default("")
  portions           BigInt              @default(1)
  steps              Json                @default("[]") @db.Json
  // Relations
  recipesIngredients RecipesIngredient[]
  tags               Tag[]
  weekPlanMeals      WeekPlanMeal[]
}

model RecipesIngredient {
  id                BigInt             @id @unique @default(autoincrement())
  recipe_id         BigInt
  raw_id            Int?
  name              String             @default("")
  amount            Decimal            @default(0) @db.Decimal
  unit              String?
  // Relations
  raw               Raw?               @relation(fields: [raw_id], references: [id], onUpdate: NoAction)
  recipes           Recipe             @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shoppingListItems ShoppingListItem[]
}

model TagCategory {
  id   Int    @id @unique @default(autoincrement())
  name String @unique @default("")
  // Relations
  tags Tag[]
}

model Tag {
  id            Int            @id @unique @default(autoincrement())
  name          String         @default("")
  categoryId    Int
  // Relations
  category      TagCategory    @relation(fields: [categoryId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  raws          Raw[]
  recipes       Recipe[]
  weekPlanMeals WeekPlanMeal[]

  @@unique([name, categoryId])
}

model WeekPlan {
  year  Int
  week  Int
  // Relations
  meals WeekPlanMeal[]

  @@id([year, week])
}

model WeekPlanMeal {
  id        Int      @id @unique @default(autoincrement())
  year      Int
  week      Int
  day       Int
  name      String
  slot      Int
  size      Int      @default(1)
  recipe_id BigInt?
  // Relations
  weekPlan  WeekPlan @relation(fields: [year, week], references: [year, week], onUpdate: NoAction, onDelete: Cascade)
  recipe    Recipe?  @relation(fields: [recipe_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  tags      Tag[]
}

enum ShoppingListState {
  TODO
  IN_CART
  BOUGHT
  NOT_BUING
}

model ShoppingListItem {
  id          String              @id @unique @default(uuid()) @db.Uuid
  name        String              @default("")
  amount      Decimal             @default(0) @db.Decimal
  unit        String?
  state       ShoppingListState   @default(TODO)
  order       Int                 @default(autoincrement())
  // Relations
  ingredients RecipesIngredient[]
}
